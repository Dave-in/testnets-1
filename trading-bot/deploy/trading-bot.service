# systemd-сервис: бот работает круглосуточно и сам поднимается после сбоя или перезагрузки VPS.
#   sudo cp deploy/trading-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now trading-bot
#   journalctl -u trading-bot -f        # живой лог
# Поправьте User и пути, если проект лежит не в /opt/testnets-1/trading-bot.
[Unit]
Description=Crypto signal bot (paper trading + Telegram)
After=network-online.target
Wants=network-online.target

[Service]
User=bot
WorkingDirectory=/opt/testnets-1/trading-bot
ExecStart=/opt/testnets-1/trading-bot/.venv/bin/python -m bot --config config.signals.toml run
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
