# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Telegram (нужно для сигнального бота):
#   TELEGRAM_BOT_TOKEN — выдаёт @BotFather после команды /newbot
#   TELEGRAM_CHAT_ID   — покажет команда: python -m bot tg-setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ключи бирж нужны только для режимов testnet / live. Для backtest и paper — не нужны.
# Ключи делайте БЕЗ права вывода средств (withdraw) и с привязкой к IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
