# Домен, на котором будет работать приложение (для HTTPS через Caddy в docker-compose).
# Нет своего домена? Используйте IP сервера через sslip.io, например 203.0.113.10.sslip.io
DOMAIN=

# Пароль для входа в приложение (обязательно задайте, иначе любой, кто узнает адрес, потратит ваши деньги)
APP_PASSWORD=придумайте-длинный-пароль

# --- Qwen LiveTranslate (Alibaba Cloud Model Studio) ---
DASHSCOPE_API_KEY=sk-...
# intl — международный аккаунт (alibabacloud.com, Сингапур); cn — китайский (aliyun.com)
QWEN_REGION=intl
# Для ключей вида sk-ws-… : «API Host» из окна создания ключа, например ws-xxxxxxxx.ap-southeast-1.maas.aliyuncs.com
QWEN_API_HOST=
QWEN_MODEL=qwen3.5-livetranslate-flash-realtime
# Необязательно: ID заранее созданного клона голоса в Qwen (появится пункт «Мой заранее созданный клон»)
QWEN_VOICE_ID=

# --- ElevenLabs (режим «ElevenLabs») ---
ELEVENLABS_API_KEY=
# ID вашего клонированного голоса: elevenlabs.io → Voices → ваш голос → Copy voice ID
ELEVENLABS_VOICE_ID=
# eleven_v4_turbo — быстрая и хорошо держит клон; запасные: eleven_flash_v2_5, eleven_multilingual_v2
ELEVENLABS_MODEL=eleven_v4_turbo

# Через сколько минут сессия остановится сама (защита от забытого включённого микрофона)
MAX_SESSION_MINUTES=60
